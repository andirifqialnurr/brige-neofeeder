APP_NAME="Bridge Neo Feeder"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://bridge.example.com
FRONTEND_URL=https://bridge.example.com
ADMIN_NAME="Bridge Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bridge_neofeeder
DB_USERNAME=bridge
DB_PASSWORD=change_this_database_password

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CREDENTIAL_ENCRYPTION_KEY=
NEOFEEDER_DEFAULT_TIMEOUT_MS=30000
UPLOAD_MAX_SIZE_MB=25
